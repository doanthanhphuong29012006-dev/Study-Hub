generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String     @unique @db.VarChar(150)
  slug        String     @unique @db.VarChar(150)
  description String?
  documents   Document[]

  @@map("categories")
}

model Document {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title          String          @db.VarChar(255)
  description    String?
  file_url       String          @db.VarChar(2048)
  file_type      String          @db.VarChar(255)
  file_size      Int
  uploader_id    String?         @db.Uuid
  category_id    String?         @db.Uuid
  status         String?         @default("pending") @db.VarChar(20)
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  updated_at     DateTime?       @default(now()) @db.Timestamp(6)
  view_count     Int?            @default(0)
  download_count Int?            @default(0)
  category       Category?       @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  uploader       User?           @relation(fields: [uploader_id], references: [id], onUpdate: NoAction)
  reviews        Review[]
  savedDocuments SavedDocument[]

  @@index([category_id], map: "idx_documents_category")
  @@index([title], map: "idx_documents_title")
  @@map("documents")
}

model Review {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  document_id String?   @db.Uuid
  user_id     String?   @db.Uuid
  rating      Int       @db.SmallInt
  comment     String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  document    Document? @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([document_id, user_id], map: "unique_document_user_review")
  @@index([document_id], map: "idx_reviews_document")
  @@map("reviews")
}

model SavedDocument {
  user_id     String    @db.Uuid
  document_id String    @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  document    Document  @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, document_id])
  @@map("saved_documents")
}

model User {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email          String          @unique @db.VarChar(255)
  password_hash  String          @db.VarChar(255)
  full_name      String          @db.VarChar(100)
  role           String?         @default("student") @db.VarChar(20)
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  updated_at     DateTime?       @default(now()) @db.Timestamp(6)
  avatar         String?         @default("https://res.cloudinary.com/unvqsun9/image/upload/v1785484308/fntkyawxwwpygdr4imx2.webp") @db.VarChar(255)
  status         String?         @default("active") @db.VarChar(20)
  documents      Document[]
  reviews        Review[]
  savedDocuments SavedDocument[]

  @@map("users")
}
